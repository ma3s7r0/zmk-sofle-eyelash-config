#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};


/ {

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp GRAVE
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BACKSPACE
&kp LSHFT   &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp APOS
&kp LCTRL   &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp RCTRL
&kp C_MUTE  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &mo 1   &kp SPACE    &kp ENTER        &kp ENTER  &mo 2   &kp LEFT_ALT &kp RIGHT_SHIFT  &kp DELETE
            >;
            
            sensor-bindings = <&scroll_encoder>;
            display-name = "qwerty";
        };

        layer_1 {
            bindings = <
&kp ESC     &kp F1           &kp F2          &kp F3           &kp F4           &kp F5         &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &trans
&kp TAB     &kp GRAVE        &mkp LCLK       &kp RA(5)        &mkp RCLK        &mkp MB4       &mmv MOVE_DOWN   &kp PG_UP        &kp RA(Y)        &kp UP      &kp RA(P)  &kp MINUS         &kp DELETE
&kp LSHFT   &kp RA(Q)        &kp RA(S)       &trans           &trans           &mkp MB5       &mmv MOVE_LEFT   &kp LEFT         &kp DOWN         &kp UP      &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LCTRL   &trans           &trans          &trans           &trans           &trans         &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &trans         &mkp LCLK        &kp ENTER        &mo 3          &trans      &trans     &trans
            >;

            display-name = "nav&special";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans     &trans     &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans     &trans     &kp LPAR  &kp RPAR  &trans    &kp BACKSPACE
&trans  &trans  &trans  &trans  &trans      &trans          &trans        &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp PIPE  &trans
&trans  &trans  &trans  &trans  &trans      &trans          &trans        &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp BSLH  &trans
&trans  &trans  &trans  &trans  &mo 3       &trans          &trans        &trans     &trans     &trans    &trans    &trans
            >;

            display-name = "sym";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&kp TILDE  &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4    &mmv MOVE_UP     &kp F6           &kp F7              &kp F8      &kp F9     &kp F10      &kp PSCRN
&sys_reset &bt BT_CLR       &bt BT_CLR_ALL  &trans           &trans           &trans          &mmv MOVE_DOWN   &trans           &trans              &kp F11     &kp F12    &kp UNDER    &sys_reset
&bt BT_CLR &out OUT_USB     &out OUT_BLE    &trans           &trans           &trans          &mmv MOVE_LEFT   &trans           &trans              &trans      &trans     &kp LBRC     &kp RBRC
&trans     &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD     &sys_reset  &soft_off  &bootloader  &trans
&trans     &trans           &trans          &trans           &trans           &trans          &mkp LCLK        &trans           &trans              &trans      &trans     &trans
            >;

            display-name = "config";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
